#!/bin/sh

################################################################################
#
#  ollama-create
#
#  Create a custom model for Ollama from an existing tags in Ollama repository.
#  The script won't handle input validations and delegate it to Ollama.
#
#  Usage:
#    ollama-create <model:tag> [base_model:tag] [context_size_KB] [temperature] [top_k] [top_p] [repeat_penalty] [min_p] [kv_cache] [verify_0_or_1]
#    ollama-create <model:tag> [-c <KB>] [-b <model:tag>] [-v <0/1>] [-r <float>] [-t <float>] [-k <int>] [-p <float>] [-n <float>] [-e <kv_cache>] [-H <url>]
#
#  Example:
#    ollama-create qwen3.6:37b-q4_K_M
#    ollama-create qwen3.6:37b-q4_K_M qwen3.6:37b-q4_K_M 256
#    ollama-create qwen3.6:27b-q8_0 -c 256 -t 0.7 -k 40 -p 0.9 -r 1.1 -P 0.05 -v 1
#
#  MIT License.
#  Copyright (C) 2025 Nguyen Nhat Tung.
#
################################################################################

set -eu

if [ ${#} -eq 0 ]; then
	echo "Error: MODEL argument is required" >&2
	exit 1
fi

MODEL="${1}"
BASE_MODEL=""
CONTEXT_SIZE=""
TEMPERATURE=""
TOP_K=""
TOP_P=""
REPEAT_PENALTY=""
MIN_P=""
KV_CACHE=""
VERIFY="0"
OLLAMA_HOST=""

shift 1

case "${1:-}" in
	-*)
		while getopts "b:c:t:k:p:r:P:e:v:h:" opt; do
			case "${opt}" in
				b) BASE_MODEL="${OPTARG}" ;;
				c) CONTEXT_SIZE="${OPTARG}" ;;
				t) TEMPERATURE="${OPTARG}" ;;
				k) TOP_K="${OPTARG}" ;;
				p) TOP_P="${OPTARG}" ;;
				r) REPEAT_PENALTY="${OPTARG}" ;;
				P) MIN_P="${OPTARG}" ;;
				e) KV_CACHE="${OPTARG}" ;;
				v) VERIFY="${OPTARG}" ;;
				h) OLLAMA_HOST="${OPTARG}" ;;
				*) echo "Error: Unknown option: -${OPTARG}" >&2; exit 1 ;;
			esac
		done
		;;
	*)
		BASE_MODEL="${1:-}"
		CONTEXT_SIZE="${2:-}"
		TEMPERATURE="${3:-}"
		TOP_K="${4:-}"
		TOP_P="${5:-}"
		REPEAT_PENALTY="${6:-}"
		MIN_P="${7:-}"
		KV_CACHE="${8:-}"
		VERIFY="${9:-0}"
		OLLAMA_HOST="${10:-}"
		;;
esac

: "${OLLAMA_HOST:=${OLLAMA_HOST:-http://127.0.0.1:11434}}"

NEW_MODEL="${MODEL}"
BASE_MODEL="${BASE_MODEL:-${NEW_MODEL}}"
LOAD_N_VERIFY=$([ "${VERIFY}" -ne 0 ] && echo "1" || echo "0")

CTXDIR="$(cd "$(dirname "${0}")" && pwd)"

mfFile=$(mktemp "${CLIINST_TMP:-/tmp}/ollama_XXXXXX.Modelfile")
trap 'rm -f "${mfFile}" 2>/dev/null || true' EXIT INT TERM

{
	echo "FROM ${BASE_MODEL}"
	if [ -n "${CONTEXT_SIZE}" ]; then
		echo "PARAMETER num_ctx $((CONTEXT_SIZE * 1024))"
	fi
	if [ -n "${REPEAT_PENALTY}" ]; then
		echo "PARAMETER repeat_penalty ${REPEAT_PENALTY}"
	fi
	if [ -n "${TEMPERATURE}" ]; then
		echo "PARAMETER temperature ${TEMPERATURE}"
	fi
	if [ -n "${TOP_K}" ]; then
		echo "PARAMETER top_k ${TOP_K}"
	fi
	if [ -n "${TOP_P}" ]; then
		echo "PARAMETER top_p ${TOP_P}"
	fi
	if [ -n "${MIN_P}" ]; then
		echo "PARAMETER min_p ${MIN_P}"
	fi
	if [ -n "${KV_CACHE}" ]; then
		echo "PARAMETER kv_cache ${KV_CACHE}"
	fi
} > "${mfFile}"

echo "> Creating new model: ${NEW_MODEL}"
ollama create "${NEW_MODEL}" -f "${mfFile}"
_ollama_exit=${?}
if [ ${_ollama_exit} -ne 0 ]; then
	echo "ollama create failed with exit code ${_ollama_exit}" >&2
	exit 1
fi

if [ "${LOAD_N_VERIFY}" = "1" ]; then
	"${CTXDIR}/ollama-info" "${MODEL}" -h "${OLLAMA_HOST}"
else
	echo "> Success."
	sleep 1
fi

echo ""
