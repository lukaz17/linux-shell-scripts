#!/bin/sh
################################################################################
#
#  ollama-create
#
#  Create a custom model for Ollama from an existing tags in Ollama repository.
#  If version is not specified, the latest version will be installed.
#  The script won't handle input validations and delegate it to Ollama.
#
#  Usage:
#    ollama-create <model:tag> [context_size_KB] [base_model:tag] [verify_0_or_1]
#    ollama-create -m <model:tag> [-c <KB>] [-b <model:tag>] [-v <0/1>]
#
#  Example:
#    ollama-create qwen3.6:37b-q4_K_M
#    ollama-create qwen3.6:37b-q4_K_M 256
#    ollama-create qwen3.6:37b-q4_K_M 256 qwen3.6:37b-q4_K_M
#    ollama-create qwen3.6:37b-q4_K_M 256 qwen3.6:37b-q4_K_M 1
#    ollama-create -m qwen3.6:37b-q4_K_M -c 256 -b qwen3.6:37b-q4_K_M -v 1
#
#  MIT License.
#  Copyright (C) 2025 Nguyen Nhat Tung.
#
################################################################################

set -eu

if [ $# -eq 0 ]; then
	echo "Error: MODEL argument is required" >&2
	exit 1
fi

MODEL=""
CONTEXT_SIZE=""
BASE_MODEL=""
VERIFY="0"

case "$1" in
	-*)
		# Flag-based parsing with getopts
		while getopts "m:c:b:v:" opt; do
			case "$opt" in
				m) MODEL="$OPTARG" ;;
				c) CONTEXT_SIZE="$OPTARG" ;;
				b) BASE_MODEL="$OPTARG" ;;
				v) VERIFY="$OPTARG" ;;
				*)
					echo "Invalid option: -$opt" >&2
					exit 1
					;;
			esac
		done

		# Validate required parameter
		if [ -z "$MODEL" ]; then
			echo "Error: -m MODEL is required" >&2
			exit 1
		fi
		;;
	*)
		# Positional parsing
		MODEL="$1"
		CONTEXT_SIZE="${2:-}"
		BASE_MODEL="${3:-}"
		VERIFY="${4:-0}"
		;;
esac

NEW_MODEL="$MODEL"
BASE_MODEL="${BASE_MODEL:-$NEW_MODEL}"
LOAD_N_VERIFY=$([ "$VERIFY" -ne 0 ] && echo "1" || echo "0")

# Create temporary Modelfile
mfFile=$(mktemp "${TMPDIR:-/tmp}/ollama_XXXXXX.Modelfile")
trap 'rm -f "$mfFile" 2>/dev/null || true' EXIT INT TERM
echo "FROM ${BASE_MODEL}" > "${mfFile}"
if [ -n "${CONTEXT_SIZE}" ]; then
	echo "PARAMETER num_ctx $((CONTEXT_SIZE * 1024))" >> "${mfFile}"
fi

echo "> Creating new model: ${NEW_MODEL}"
ollama create "${NEW_MODEL}" -f "${mfFile}"
if [ $? -ne 0 ]; then
	echo "ollama create failed with exit code $?" >&2
	exit 1
fi

if [ "${LOAD_N_VERIFY}" = "1" ]; then
	echo "> Load model into memory."
	loadBody=$(jq -n --arg model "${MODEL}" '{model: $model, messages: [], keep_alive: 60}')
	if ! curl -sS -X POST -H "Content-Type: application/json" -d "${loadBody}" http://127.0.0.1:11434/api/chat >/dev/null 2>&1; then
		echo "Failed to load model into memory" >&2
		exit 1
	fi

	echo "> Query model details."
	psResponse=$(curl -sS -X GET http://127.0.0.1:11434/api/ps 2>&1)
	if [ $? -ne 0 ]; then
		echo "Failed to query /api/ps" >&2
		exit 1
	fi

	name=$(echo "$psResponse" | jq -r '.models[0].name // empty')
	param_size=$(echo "$psResponse" | jq -r '.models[0].details.parameter_size // empty')
	quant_level=$(echo "$psResponse" | jq -r '.models[0].details.quantization_level // empty')
	family=$(echo "$psResponse" | jq -r '.models[0].details.family // empty')
	ctx_length=$(echo "$psResponse" | jq -r '.models[0].context_length // empty')
	size=$(echo "$psResponse" | jq -r '.models[0].size // empty')

	if [ -z "$name" ]; then
		echo "Model not found in /api/ps" >&2
		exit 1
	fi

	printf "Name               : %s\n" "$name"
	printf "Parameter Size     : %s\n" "$param_size"
	printf "Quantization Level : %s\n" "$quant_level"
	printf "Family             : %s\n" "$family"
	printf "Context Size       : %s\n" "$ctx_length"
	printf "Memory             : %s\n" "$size"
	echo "> Success."
else
	echo "> Success."
	sleep 1
fi

echo ""
