#!/bin/sh

################################################################################
#
#  op-node-install
#
#  Install/Update op-node for current user. This also works as a version manager.
#  If version is not specified, the latest version will be installed.
#
#  Homepage: https://www.optimism.io/
#
#  Prerequisites:
#  - Go
#  - yq
#  - zip
#
#  Usage:
#    op-node-install [<version>]
#
#  Example:
#    op-node-install
#    op-node-install 1.14.1
#    op-node-install v1.14.1
#
#  MIT License.
#  Copyright (C) 2025 Nguyen Nhat Tung.
#
################################################################################

set -e

# Application info
PROGRAM_ID="op-node"
PROGRAM_EXEC="op-node"
REGISTRY_ID="superchain-registry"

# Shared library
CTXDIR="$(cd "$(dirname "${0}")" && pwd)"
. "${CTXDIR}/shared/install-common.sh"
. "${CTXDIR}/shared/install-source.sh"

# Prepare environment
GITHUB_OWNER="$(get_source_owner "${PROGRAM_ID}")"
GITHUB_REPO="$(get_source_repo "${PROGRAM_ID}")"
get_install_version_from_github "${GITHUB_OWNER}" "${GITHUB_REPO}" "${1}" "op-node/v" "op-node/v"
init_install_env "${PROGRAM_ID}" "${INSTALL_VERSION}"

# Download and install binaries
if [ ! -d "${INSTALL_TARGET}" ]; then
	SRC_ARCH_URI_AMD64="$(get_download_uri_amd64 "${PROGRAM_ID}" "${INSTALL_VERSION}")"
	SRC_ARCH_URI_ARM64="$(get_download_uri_arm64 "${PROGRAM_ID}" "${INSTALL_VERSION}")"
	SRC_ARCH_TMP_FILE="${TEMP_TARGET}.tar.gz"
	download_uri_per_arch "${SRC_ARCH_URI_AMD64}" "${SRC_ARCH_URI_ARM64}" "${SRC_ARCH_TMP_FILE}"
	create_dir "${TEMP_TARGET}"
	extract_archive "${SRC_ARCH_TMP_FILE}" "tar" "${TEMP_TARGET}"
	remove_item "${SRC_ARCH_TMP_FILE}"
	if is_version_at_least "${INSTALL_VERSION}" "1.10.0"; then
		SRC_ROOT="${TEMP_TARGET}/${GITHUB_REPO}-${PROGRAM_ID}-v${INSTALL_VERSION}"
	else
		SRC_ROOT="${TEMP_TARGET}/${GITHUB_REPO}-${INSTALL_VERSION}"
	fi
	if is_version_at_least "${INSTALL_VERSION}" "1.19.1"; then
		REGISTRY_COMMIT="$(curl -fsSL "https://api.github.com/repos/${GITHUB_OWNER}/${GITHUB_REPO}/contents/${REGISTRY_ID}?ref=${PROGRAM_ID}/v${INSTALL_VERSION}" | jq -r '.sha // empty')"
		if [ -z "${REGISTRY_COMMIT}" ]; then
			echo "op-node-install: Cannot resolve ${REGISTRY_ID} commit for v${INSTALL_VERSION}" >&2
			exit 1
		fi
		REG_ARCH_URI_AMD64="$(get_download_uri_amd64 "${REGISTRY_ID}" "${REGISTRY_COMMIT}")"
		REG_ARCH_URI_ARM64="$(get_download_uri_arm64 "${REGISTRY_ID}" "${REGISTRY_COMMIT}")"
		REG_ARCH_TMP_FILE="${TEMP_TARGET}-${REGISTRY_ID}.tar.gz"
		download_uri_per_arch "${REG_ARCH_URI_AMD64}" "${REG_ARCH_URI_ARM64}" "${REG_ARCH_TMP_FILE}"
		extract_archive "${REG_ARCH_TMP_FILE}" "tar" "${SRC_ROOT}"
		remove_item "${REG_ARCH_TMP_FILE}"
		remove_item "${SRC_ROOT}/${REGISTRY_ID}"
		move_item "${SRC_ROOT}/${REGISTRY_ID}-${REGISTRY_COMMIT}" "${SRC_ROOT}/${REGISTRY_ID}"
		if is_version_at_least "${INSTALL_VERSION}" "1.20.1"; then
			bash "${SRC_ROOT}/op-core/superchain/bundle/sync-superchain.sh"
		else
			bash "${SRC_ROOT}/op-core/superchain/sync-superchain.sh"
		fi
	fi
	cd "${SRC_ROOT}"
	cd "op-node"
	env GO111MODULE=on GOOS=linux CGO_ENABLED=0 go build -v -ldflags "-X main.GitCommit=release -X main.GitDate=$(date +%s) -X github.com/ethereum-optimism/optimism/op-node/version.Version=v${INSTALL_VERSION} -X github.com/ethereum-optimism/optimism/op-node/version.Meta=" -o ./bin/op-node ./cmd
	move_item "${SRC_ROOT}/op-node/bin" "${INSTALL_TARGET}"
	remove_item "${TEMP_TARGET}"
fi

# Finalize install
symlink_item_overwrite "${INSTALL_TARGET}" "${ACTIVE_TARGET}"
symlink_item_overwrite "${ACTIVE_TARGET}/${PROGRAM_EXEC}" "${SYSTEM_BIN_ROOT}/${PROGRAM_ID}"
finalize_install
