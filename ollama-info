#!/bin/bash

################################################################################
#
#  ollama-info
#
#  Load a model into memory and print its runtime info from an Ollama server.
#
#  Usage:
#    ollama-info <model:tag> [-h <host_url>]
#
#  Example:
#    ollama-info qwen3.6:27b-q8_0
#    ollama-info qwen3.6:27b-q8_0 -h http://ollama.local
#
#  MIT License.
#  Copyright (C) 2025 Nguyen Nhat Tung.
#
################################################################################

set -eu

MODEL=""
OLLAMA_HOST="${OLLAMA_HOST:-http://127.0.0.1:11434}"

while [ ${#} -gt 0 ]; do
	case "${1}" in
		-H)
			OLLAMA_HOST="${2}"
			shift 2
			;;
		-*)
			echo "Unknown option: ${1}" >&2
			exit 1
			;;
		*)
			if [ -z "${MODEL}" ]; then
				MODEL="${1}"
			fi
			shift
			;;
	esac
done

if [ -z "${MODEL}" ]; then
	echo "Error: MODEL argument is required" >&2
	exit 1
fi
echo "> Check model capabilities."
showBody="{\"name\":\"${MODEL}\"}"
showResponse=$(curl -sS -X POST -H "Content-Type: application/json" -d "${showBody}" "${OLLAMA_HOST}/api/show" 2>&1)

isEmbedding=$(echo "${showResponse}" | jq -r 'if (.capabilities // []) | index("embedding") then true else false end')
architecture=$(echo "${showResponse}" | jq -r 'if (.model_info | has("general.architecture")) then .model_info["general.architecture"] else "" end')
parameter_count=$(echo "${showResponse}" | jq -r 'if (.model_info | has("general.parameter_count")) then .model_info["general.parameter_count"] else "" end')
family=$(echo "${showResponse}" | jq -r '.details.family // ""')
contextLength=$(echo "${showResponse}" | jq -r --arg fam "${family}" 'if (.model_info | has($fam + ".context_length")) then .model_info[$fam + ".context_length"] else "" end')
capabilities=$(echo "${showResponse}" | jq -r '(.capabilities // []) | join(", ")')

echo "> Load model into memory."
if [ "${isEmbedding}" = "true" ]; then
	if ! ollama run "${MODEL}" "hello world" >/dev/null 2>&1; then
		echo "Failed to load model into memory" >&2
		exit 1
	fi
else
	loadBody=$(jq -n --arg model "${MODEL}" '{model: $model, messages: [], keep_alive: 300}')
	if ! curl -sS -X POST -H "Content-Type: application/json" -d "${loadBody}" "${OLLAMA_HOST}/api/chat" >/dev/null 2>&1; then
		echo "Failed to load model into memory" >&2
		exit 1
	fi
fi

echo "> Query model details."
psResponse=$(curl -sS -X GET "${OLLAMA_HOST}/api/ps" 2>&1)

modelInfo=$(echo "${psResponse}" | jq -r --arg model "${MODEL}" '
	.models[] | select(.model == $model) |
	{
		name: .name,
		family: .details.family,
		parameter_size: .details.parameter_size,
		quantization_level: .details.quantization_level,
		context_length: .context_length,
		size: .size,
		size_vram: .size_vram
	} | @json' | head -1)

if [ -z "${modelInfo}" ]; then
	echo "Model not found in /api/ps" >&2
	exit 1
fi

name=$(echo "${modelInfo}" | jq -r '.name')
fam=$(echo "${modelInfo}" | jq -r '.family')
param_size=$(echo "${modelInfo}" | jq -r '.parameter_size')
quant=$(echo "${modelInfo}" | jq -r '.quantization_level')
ctx_allocated=$(echo "${modelInfo}" | jq -r '.context_length')
size=$(echo "${modelInfo}" | jq -r '.size')
size_vram=$(echo "${modelInfo}" | jq -r '.size_vram')

ctx_pct=$(awk "BEGIN {printf \"%.1f\", ${ctx_allocated} * 100 / ${contextLength}}" 2>/dev/null)
vram_pct=$(awk "BEGIN {printf \"%.1f\", ${size_vram} * 100 / ${size}}" 2>/dev/null)

echo "Name               : ${name}"
echo "Family             : ${fam}"
echo "Architecture       : ${architecture}"
echo "Parameter Size     : ${param_size}"
echo "Parameter Count    : ${parameter_count}"
echo "Quantization       : ${quant}"
echo "Context Length     : ${contextLength}"
echo "Context Allocated  : ${ctx_allocated} (${ctx_pct}%)"
echo "Context Memory     : ${size}"
echo "VRAM Usage         : ${size_vram} (${vram_pct}%)"
echo "Capabilities       : ${capabilities}"
echo "> Success."
