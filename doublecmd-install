#!/bin/sh

################################################################################
#
#  doublecmd-install
#
#  Install/Update Double Commander for current user. This also works as a version manager.
#  If version is not specified, the latest version will be installed.
#
#  Homepage: https://doublecmd.sourceforge.io/
#
#  Usage:
#    doublecmd-install [<version>]
#
#  Example:
#    doublecmd-install
#    doublecmd-install 1.45.0
#    doublecmd-install v1.45.0
#
#  MIT License.
#  Copyright (C) 2025 Nguyen Nhat Tung.
#
################################################################################

set -ex

# Application info
GITHUB_OWNER="doublecmd"
GITHUB_REPO="doublecmd"
PROGRAM_ID="doublecmd"
PROGRAM_EXEC="doublecmd"

# Shared library
CTXDIR="$(cd "$(dirname "$0")" && pwd)"
. "${CTXDIR}/shared/install-common.sh"

# Prepare environment
get_install_version_from_github "${GITHUB_OWNER}" "${GITHUB_REPO}" "$1"
init_install_env_desktop "${PROGRAM_ID}" "${INSTALL_VERSION}"

# Download and install binaries
if [ ! -d "${INSTALL_TARGET}" ]; then
	BIN_ARCH_URI_AMD64="https://github.com/${GITHUB_OWNER}/${GITHUB_REPO}/releases/download/v${INSTALL_VERSION}/doublecmd-${INSTALL_VERSION}.qt.x86_64.tar.xz"
	BIN_ARCH_URI_ARM64="https://github.com/${GITHUB_OWNER}/${GITHUB_REPO}/releases/download/v${INSTALL_VERSION}/doublecmd-${INSTALL_VERSION}.qt.aarch64.tar.xz"
	BIN_ARCH_TMP_FILE="${TEMP_TARGET}.tar.xz"
	download_uri_per_arch "${BIN_ARCH_URI_AMD64}" "${BIN_ARCH_URI_ARM64}" "${BIN_ARCH_TMP_FILE}"
	create_dir "${TEMP_TARGET}"
	extract_archive "${BIN_ARCH_TMP_FILE}" "tar" "${TEMP_TARGET}"
	remove_item "${BIN_ARCH_TMP_FILE}"
	move_item "${TEMP_TARGET}/doublecmd" "${INSTALL_TARGET}"
	remove_item "${TEMP_TARGET}"
fi

# Finalize install
copy_item_overwrite "${INSTALL_TARGET}" "${ACTIVE_TARGET}"
symlink_item_overwrite "${ACTIVE_TARGET}/${PROGRAM_EXEC}" "${SYSTEM_BIN_ROOT}/${PROGRAM_ID}"
install_desktop "${PROGRAM_ID}" "${CTXDIR}" "${DESKTOP_ROOT}" "${ICON_ROOT}"
install_polkit_policy "org.doublecmd.root" "${CTXDIR}"
