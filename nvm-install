#!/bin/sh

################################################################################
#
#  nvm-install
#
#  Install/Update Node Version Manager for current user. This also works as a version manager.
#  If version is not specified, the latest version will be installed.
#
#  Homepage: https://github.com/nvm-sh/nvm
#
#  Usage:
#    nvm-install [<version>]
#
#  Example:
#    nvm-install
#    nvm-install 0.40.3
#    nvm-install v0.40.3
#
#  MIT License.
#  Copyright (C) 2025 Nguyen Nhat Tung.
#
################################################################################

set -e

# Application info
PROGRAM_ID="nvm"

# Shared library
CTXDIR="$(cd "$(dirname "${0}")" && pwd)"
. "${CTXDIR}/shared/install-common.sh"
. "${CTXDIR}/shared/install-source.sh"

# Prepare environment
GITHUB_OWNER="$(get_source_owner "${PROGRAM_ID}")"
GITHUB_REPO="$(get_source_repo "${PROGRAM_ID}")"
get_install_version_from_github "${GITHUB_OWNER}" "${GITHUB_REPO}" "${1}"
init_install_env "${PROGRAM_ID}" "${INSTALL_VERSION}"

# Download and install scripts
if [ ! -d "${INSTALL_TARGET}" ]; then
	SRC_ARCH_URI_AMD64="$(get_download_uri_amd64 "${PROGRAM_ID}" "${INSTALL_VERSION}")"
	SRC_ARCH_URI_ARM64="$(get_download_uri_arm64 "${PROGRAM_ID}" "${INSTALL_VERSION}")"
	SRC_ARCH_TMP_FILE="${TEMP_TARGET}.tar.gz"
	download_uri_per_arch "${SRC_ARCH_URI_AMD64}" "${SRC_ARCH_URI_ARM64}" "${SRC_ARCH_TMP_FILE}"
	create_dir "${TEMP_TARGET}"
	extract_archive "${SRC_ARCH_TMP_FILE}" "tar" "${TEMP_TARGET}"
	remove_item "${SRC_ARCH_TMP_FILE}"
	move_item "${TEMP_TARGET}/${GITHUB_REPO}-${INSTALL_VERSION}" "${INSTALL_TARGET}"
	remove_item "${TEMP_TARGET}"
fi

# Finalize install
symlink_item_overwrite "${INSTALL_TARGET}" "${ACTIVE_TARGET}"
cat << EOF > "${INSTALL_ROOT}/env.sh"
export NVM_DIR="\${CLIINST_USR_PROFILE:-\$HOME/.local}/.${PROGRAM_ID}"
[ -s "${ACTIVE_TARGET}/nvm.sh" ] && . "${ACTIVE_TARGET}/nvm.sh"
EOF
cat << EOF > "${INSTALL_ROOT}/bash.sh"
[ -s "${ACTIVE_TARGET}/bash_completion" ] && \. "${ACTIVE_TARGET}/bash_completion"
EOF
# nvm runs nvm-exec from NVM_DIR, and nvm-exec loads nvm.sh from its own folder
create_user_dir "${USER_PROFILE_DATA}/.${PROGRAM_ID}"
symlink_item_overwrite "${ACTIVE_TARGET}/nvm-exec" "${USER_PROFILE_DATA}/.${PROGRAM_ID}/nvm-exec"
symlink_item_overwrite "${ACTIVE_TARGET}/nvm.sh" "${USER_PROFILE_DATA}/.${PROGRAM_ID}/nvm.sh"
append_text_idempotent "\n# nvm" "${USER_BASH_RC}"
append_text_idempotent ". \"${INSTALL_ROOT}/env.sh\"" "${USER_BASH_RC}"
append_text_idempotent ". \"${INSTALL_ROOT}/bash.sh\"" "${USER_BASH_RC}"
finalize_install
