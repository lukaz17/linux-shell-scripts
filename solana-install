#!/bin/sh

################################################################################
#
#  solana-install
#
#  Install/Update Solana for current user. This also works as a version manager.
#  If version is not specified, the latest version will be installed.
#
#  Homepage: https://www.solanalabs.com/
#
#  Usage:
#    solana-install [<version>]
#
#  Example:
#    solana-install
#    solana-install 1.18.26
#    solana-install v1.18.26
#
#  MIT License.
#  Copyright (C) 2025 Nguyen Nhat Tung.
#
################################################################################

set -e

# Application info
PROGRAM_ID="solana"
PROGRAM_EXEC="solana"

# Shared library
CTXDIR="$(cd "$(dirname "${0}")" && pwd)"
. "${CTXDIR}/shared/install-common.sh"
. "${CTXDIR}/shared/install-source.sh"

# Prepare environment
GITHUB_OWNER="$(get_source_owner "${PROGRAM_ID}")"
GITHUB_REPO="$(get_source_repo "${PROGRAM_ID}")"
get_install_version_from_github "${GITHUB_OWNER}" "${GITHUB_REPO}" "${1}"
init_install_env "${PROGRAM_ID}" "${INSTALL_VERSION}"
INSTALL_ROOT="${HOME}/.local/share/solana"
INSTALL_TARGET="${INSTALL_ROOT}/install/releases/${INSTALL_VERSION}"
ACTIVE_TARGET="${INSTALL_ROOT}/install/active_release"
create_dir "${INSTALL_ROOT}/install/releases"

# Download and install binaries
if [ ! -d "${INSTALL_TARGET}" ]; then
	BIN_ARCH_URI_AMD64="$(get_download_uri_amd64 "${PROGRAM_ID}" "${INSTALL_VERSION}")"
	BIN_ARCH_URI_ARM64="$(get_download_uri_arm64 "${PROGRAM_ID}" "${INSTALL_VERSION}")"
	BIN_ARCH_TMP_FILE="${TEMP_TARGET}.tar.bz2"
	download_uri_per_arch "${BIN_ARCH_URI_AMD64}" "${BIN_ARCH_URI_ARM64}" "${BIN_ARCH_TMP_FILE}"
	create_dir "${TEMP_TARGET}"
	extract_archive "${BIN_ARCH_TMP_FILE}" "tar" "${TEMP_TARGET}"
	remove_item "${BIN_ARCH_TMP_FILE}"
	create_dir "${INSTALL_TARGET}"
	move_item "${TEMP_TARGET}/solana-release" "${INSTALL_TARGET}/solana-release"
	remove_item "${TEMP_TARGET}"
fi

# Finalize install
symlink_item_overwrite "${INSTALL_TARGET}/solana-release" "${ACTIVE_TARGET}"
cat << EOF > "${INSTALL_ROOT}/env.sh"
export PATH="\$HOME/.local/share/solana/install/active_release/bin:\$PATH"
EOF
append_text_idempotent "\n# solana" "${USER_PROFILE_RC}"
append_text_idempotent ". \"${INSTALL_ROOT}/env.sh\"" "${USER_PROFILE_RC}"
finalize_install
